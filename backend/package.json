    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "viem": "^2.57.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
